func quicksort(iter: Iter[Num]): Iter[Num] {
    first = iter(0);
    if isnone(first){
        iter
    } else {
        pivot = unwrap(first);
        rest = drop(1, iter);
        left = filter(\x { x <= pivot }, rest);
        right = filter(\x { x > pivot }, rest);
        quicksort(left) + toIter([pivot]) + quicksort(right)
    }
};

n = 1000;
prime = 2179;
iter = (1..n) | collect | \x map(\i {x((i*prime) % n) | unwrap}, 1..n);
quicksort(iter) | collect
