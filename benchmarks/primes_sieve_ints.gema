trait Any {}

func fill(x: T, n: Int) where T is Any {
  map(\_ x, 0i..n-1i) | collect
}

func sieve(upto: Int) {
  isPrime = fill(true, upto) | unsafeTrans;
  primes = []:Int | trans;
  for i = range(2i, upto) {
    if isPrime(i-1i) | unwrap {
      push(primes, i);
      if i * i < upto {
        for m = range(0i, (upto - i*i) / i) {
          put(isPrime, m*i + i*i - 1i, false);
        }
      }
    };
  }
  primes | detrans
}

100000i | sieve | last
