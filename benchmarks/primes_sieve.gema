trait Any {}

func fill(x: T, n: Int) where T is Any {
  map(\_ x, 0..n-1) | collect
}

func sieve(upto: Int) {
  isPrime = fill(true, upto) | unsafeTrans;
  primes = []:Int | trans;
  for i = range(2, upto) {
    if isPrime(i-1)| unwrap {
      push(primes, i);
      if i * i < upto {
        for m = range(0, (upto - i*i) / i) {
          put(isPrime, m*i + i*i - 1, false);
        }
      }
    };
  }
  primes | detrans
}

100000 | sieve | last
